# Copia este archivo como .env.local y completa con los datos de tu proyecto
# (Supabase → Project Settings → API). Nunca subas .env.local al repositorio.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Cloudflare Turnstile (anti-bots). Clave PÚBLICA del sitio ("Site Key").
# La clave secreta va en Supabase → Authentication → Attack Protection, no aquí.
# Déjala vacía si el CAPTCHA está apagado en Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Notificaciones push (PWA). Clave PÚBLICA VAPID; la privada va SOLO como
# secreto de la función Edge `enviar-push` en Supabase, nunca aquí.
# Genérala con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Panel interno de Seven Stay (/admin). Clave MAESTRA de Supabase
# (Project Settings → API → service_role). SOLO va en el servidor/hosting:
# nunca le pongas NEXT_PUBLIC_ ni la compartas. Sin ella /admin no funciona.
SUPABASE_SERVICE_ROLE_KEY=
